// AI provider layer (Module 3).
// askAI() tries providers in order (default: Gemini first, Groq as fallback,
// as the proposal specifies) and moves to the next one on any error/timeout.
// Providers without an API key are skipped.
//
// Env:
//   GEMINI_API_KEY, GEMINI_MODEL (default gemini-3.6-flash; gemini-2.0-flash was shut down)
//   GROQ_API_KEY,   GROQ_MODEL   (default llama-3.3-70b-versatile)
//   AI_PROVIDER_ORDER            (default "gemini,groq")
const axios = require("axios");
const Groq = require("groq-sdk");

const GEMINI_MODEL = process.env.GEMINI_MODEL || "gemini-3.6-flash";
const GROQ_MODEL = process.env.GROQ_MODEL || "llama-3.3-70b-versatile";
const TIMEOUT_MS = 45000;

let groqClient = null;
function groq() {
  if (!groqClient) groqClient = new Groq({ apiKey: process.env.GROQ_API_KEY });
  return groqClient;
}

// options.maxTokens — output budget; options.json — ask for a JSON object (the
// prompt must also say "JSON"); options.system — optional system instruction.
async function askGroq(prompt, options = {}) {
  const messages = [];
  if (options.system) messages.push({ role: "system", content: options.system });
  messages.push({ role: "user", content: prompt });
  const completion = await groq().chat.completions.create(
    {
      model: GROQ_MODEL,
      messages,
      max_tokens: options.maxTokens || 1200,
      ...(options.json ? { response_format: { type: "json_object" } } : {}),
    },
    { timeout: TIMEOUT_MS }
  );
  const text = completion.choices?.[0]?.message?.content;
  if (!text) throw new Error("Groq returned an empty response");
  return text;
}

// Gemini through its REST API (no SDK, so model names never depend on an old package).
async function askGemini(prompt, options = {}) {
  const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(GEMINI_MODEL)}:generateContent`;
  const body = {
    contents: [{ role: "user", parts: [{ text: prompt }] }],
    generationConfig: {
      // Gemini 3.x "thinks" before answering; keep that light (faster, uses
      // less free quota) and leave headroom in case thinking tokens count
      // towards the output limit.
      maxOutputTokens: (options.maxTokens || 1200) + 1024,
      thinkingConfig: { thinkingLevel: process.env.GEMINI_THINKING || "low" },
      ...(options.json ? { responseMimeType: "application/json" } : {}),
    },
    ...(options.system ? { systemInstruction: { parts: [{ text: options.system }] } } : {}),
  };
  const res = await axios.post(url, body, {
    timeout: TIMEOUT_MS,
    headers: { "Content-Type": "application/json", "x-goog-api-key": process.env.GEMINI_API_KEY },
  });
  // Skip "thought" parts if the API ever returns them.
  const text = (res.data?.candidates?.[0]?.content?.parts || []).filter((p) => !p.thought).map((p) => p.text || "").join("");
  if (!text) throw new Error("Gemini returned an empty response");
  return text;
}

const PROVIDERS = {
  gemini: { ask: askGemini, key: "GEMINI_API_KEY" },
  groq: { ask: askGroq, key: "GROQ_API_KEY" },
};

function providerOrder() {
  return (process.env.AI_PROVIDER_ORDER || "gemini,groq")
    .split(",")
    .map((p) => p.trim().toLowerCase())
    .filter((p) => PROVIDERS[p] && process.env[PROVIDERS[p].key]);
}

async function askAI(prompt, options = {}) {
  const order = providerOrder();
  if (!order.length) throw new Error("No AI provider is configured (set GEMINI_API_KEY and/or GROQ_API_KEY)");
  let lastError;
  for (const name of order) {
    try {
      return await PROVIDERS[name].ask(prompt, options);
    } catch (err) {
      lastError = err;
      const detail = err.response?.data?.error?.message || err.message;
      console.warn(`[ai] ${name} failed, trying next provider: ${detail}`);
    }
  }
  throw lastError;
}

module.exports = { askAI, askGroq, askGemini };
